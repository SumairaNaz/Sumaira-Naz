<section class="gift-guide-banner">
  <div class="gift-guide-banner__bg">
    {% if section.settings.bg_image != blank %}
      <img
        src="{{ section.settings.bg_image | image_url: width: 2200 }}"
        alt="{{ section.settings.heading }}"
        loading="lazy"
      >
    {% endif %}
  </div>

  <div class="page-width">
    <div class="gift-guide-banner__content">

      <h2 class="gift-guide-banner__heading">
        {{ section.settings.heading }}
      </h2>

      <div class="gift-guide-banner__text">
        {{ section.settings.text }}
      </div>

      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="gift-guide-banner__btn">

          <span class="btn-label">
            {{ section.settings.button_label }}
          </span>

          <span class="btn-arrow">
            <svg width="31" height="12" viewBox="0 0 31 12" fill="none">
              <path d="M1 6H28" stroke="white" stroke-width="1.5"/>
              <path d="M23 1L28 6L23 11" stroke="white" stroke-width="1.5"/>
            </svg>
          </span>

        </a>
      {% endif %}

    </div>
  </div>

  <div class="gift-guide-banner__bottom">
    {{ section.settings.bottom_text }}
  </div>
</section>

<style>
.gift-guide-banner{
  position:relative;
  overflow:hidden;
  background:#e7e7e7;
}

.gift-guide-banner__bg{
  position:absolute;
  inset:0;
  z-index:1;
}

.gift-guide-banner__bg img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}

.gift-guide-banner .page-width{
  position:relative;
  z-index:2;
}

.gift-guide-banner__content{
  padding-top:138px;
  padding-bottom:138px;
  max-width:530px;
  min-height:525px;
  display:flex;
  flex-direction:column;
  justify-content:center;
}

.gift-guide-banner__heading{
  margin:0;
  font-size:82px;
  line-height:0.95;
  font-weight:700;
  letter-spacing:-3px;
  color:#000;
}

.gift-guide-banner__text{
  margin-top:42px;
  max-width:470px;

  font-size:20px;
  line-height:1.55;
  font-weight:400;
  color:#111;
}

.gift-guide-banner__btn{
  margin-top:52px;

  width:220px;
  height:58px;

  background:#000;
  color:#fff;

  display:flex;
  align-items:center;
  justify-content:center;
  gap:18px;

  text-decoration:none;

  font-size:17px;
  font-weight:500;
  letter-spacing:0.8px;

  position:relative;
  overflow:hidden;

  transition:
    background .35s ease,
    transform .35s ease;
}

.gift-guide-banner__btn:before{
  content:"";
  position:absolute;
  top:0;
  left:-120%;
  width:120%;
  height:100%;

  background:linear-gradient(
    90deg,
    transparent,
    rgba(255,255,255,.18),
    transparent
  );

  transition:left .7s ease;
}

.gift-guide-banner__btn:hover:before{
  left:120%;
}

.gift-guide-banner__btn:hover{
  background:#111;
}

.btn-arrow{
  display:flex;
  align-items:center;

  transition:transform .35s cubic-bezier(.4,0,.2,1);
}

.gift-guide-banner__btn:hover .btn-arrow{
  transform:translateX(6px);
}

.gift-guide-banner__bottom{
  position:relative;
  z-index:2;

  height:30px;

  display:flex;
  align-items:center;
  justify-content:center;

  background:#dfdfdf;

  font-size:15px;
  font-weight:500;
  letter-spacing:.6px;
  text-transform:uppercase;
  color:#000;
}

@media screen and (max-width: 1200px){

  .gift-guide-banner__heading{
    font-size:68px;
  }

  .gift-guide-banner__content{
    padding-top:100px;
    padding-bottom:100px;
  }

}

@media screen and (max-width: 767px){

  .gift-guide-banner__content{
    min-height:auto;
    padding-top:70px;
    padding-bottom:70px;
    max-width:100%;
  }

  .gift-guide-banner__heading{
    font-size:46px;
    letter-spacing:-1.5px;
  }

  .gift-guide-banner__text{
    margin-top:24px;
    font-size:16px;
    line-height:1.6;
  }

  .gift-guide-banner__btn{
    margin-top:36px;
    width:200px;
    height:54px;
    font-size:15px;
  }

  .gift-guide-banner__bottom{
    height:auto;
    min-height:36px;
    padding:8px 15px;
    text-align:center;
    font-size:12px;
    line-height:1.4;
  }

}
</style>

{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom Strip Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}