{% comment %}
  Tisso Vision Lookbook Section
{% endcomment %}

<section class="tisso-lookbook">

  <div class="page-width">

    <!-- Heading -->
    <h2 class="tisso-lookbook-heading">
      {{ section.settings.heading }}
    </h2>

    <!-- Grid -->
    <div class="tisso-lookbook-grid">

      {% for block in section.blocks %}
        
        {% assign product = all_products[block.settings.product] %}

        <div class="tisso-lookbook-item">

          <!-- Image -->
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 1000 }}"
              alt=""
              class="tisso-lookbook-image"
            >
            {% else %}
                <img
                src="{{ product.featured_image | image_url: width: 1000 }}"
                alt=""
                class="tisso-lookbook-image"
                >
          {% endif %}

          <!-- Plus Button -->
          <button
            class="tisso-plus-btn"
            data-product-id="{{ product.id }}"
            data-title="{{ product.title }}"
            data-price="{{ product.price | money }}"
            data-image="{{ product.featured_image | image_url: width: 600 }}"
          >
            +
          </button>

          <!-- Hidden Product JSON -->
          <script type="application/json" class="product-json">
            {
            "id": {{ product.id }},
            "title": {{ product.title | json }},
            "description": {{ product.description | strip_html | json }},
            "featured_image": {{ product.featured_image | image_url: width: 900 | json }},
            "options_with_values": {{ product.options_with_values | json }},
            "variants": [
                {% for variant in product.variants %}
                {
                    "id": {{ variant.id }},
                    "title": {{ variant.title | json }},
                    "price": {{ variant.price }},
                    "option1": {{ variant.option1 | json }},
                    "option2": {{ variant.option2 | json }},
                    "option3": {{ variant.option3 | json }}
                }{% unless forloop.last %},{% endunless %}
                {% endfor %}
            ]
            }
        </script>

        </div>

      {% endfor %}

    </div>

  </div>
</section>

<!-- POPUP -->
<div class="tisso-popup-overlay"></div>

<div class="tisso-product-popup">

  <button class="tisso-popup-close">
    ×
  </button>

  <div class="tisso-popup-inner">

    <!-- LEFT -->
    <div class="tisso-popup-image-wrap">
      <img src="" alt="" class="tisso-popup-image">
    </div>

    <!-- RIGHT -->
    <div class="tisso-popup-content">

      <h3 class="tisso-popup-title"></h3>

      <div class="tisso-popup-price"></div>

      <div class="tisso-popup-description"></div>

      <!-- Variant Options -->
      <div class="tisso-variant-wrapper"></div>

      <!-- Size -->
      <div class="tisso-size-wrapper"></div>

      <!-- Add to Cart -->
      <button class="tisso-add-cart">
        <span>ADD TO CART</span>
        <span>→</span>
      </button>

    </div>

  </div>

</div>



<style>

/* =========================
   SECTION
========================= */

.tisso-lookbook{
  background:#efefef;
  padding:30px 0;
}

.tisso-lookbook .page-width{
  max-width:1280px;
  margin:0 auto;
  padding:0 28px;
}

.tisso-lookbook-heading{
  font-size:52px;
  font-weight:400;
  margin-bottom:30px;
  font-family:Georgia, serif;
  color:#111;
}

/* =========================
   GRID
========================= */

.tisso-lookbook-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:22px;
}

.tisso-lookbook-item{
  position:relative;
  overflow:hidden;
  height:520px;
}

.tisso-lookbook-image{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}

/* PLUS BUTTON */

.tisso-plus-btn{
  position:absolute;
  top:50%;
  right:22px;
  transform:translateY(-50%);
  width:38px;
  height:38px;
  border-radius:50%;
  border:none;
  background:#fff;
  color:#000;
  font-size:28px;
  cursor:pointer;
  z-index:2;
}

/* =========================
   POPUP
========================= */

.tisso-popup-overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,0.45);
  opacity:0;
  visibility:hidden;
  transition:0.3s;
  z-index:9998;
}

.tisso-popup-overlay.active{
  opacity:1;
  visibility:visible;
}

.tisso-product-popup{
  position:fixed;
  top:50%;
  left:50%;
  transform:translate(-50%,-50%) scale(.9);
  width:760px;
  background:#f4f1ec;
  padding:36px;
  z-index:9999;
  opacity:0;
  visibility:hidden;
  transition:0.3s;
}

.tisso-product-popup.active{
  opacity:1;
  visibility:visible;
  transform:translate(-50%,-50%) scale(1);
}

/* CLOSE */

.tisso-popup-close{
  position:absolute;
  top:18px;
  right:18px;
  background:none;
  border:none;
  font-size:34px;
  cursor:pointer;
}

/* INNER */

.tisso-popup-inner{
  display:grid;
  grid-template-columns:260px 1fr;
  gap:34px;
}

/* IMAGE */

.tisso-popup-image{
  width:100%;
  display:block;
}

/* TITLE */

.tisso-popup-title{
  font-size:30px;
  margin-bottom:14px;
  font-weight:400;
}

/* PRICE */

.tisso-popup-price{
  font-size:34px;
  margin-bottom:20px;
}

/* DESCRIPTION */

.tisso-popup-description{
  font-size:16px;
  line-height:1.5;
  margin-bottom:24px;
  color:#444;
}

/* VARIANTS */

.tisso-option-title{
  font-size:15px;
  margin-bottom:10px;
  display:block;
}

.tisso-variant-options{
  display:flex;
  border:1px solid #000;
  margin-bottom:24px;
}

.tisso-variant-btn{
  flex:1;
  height:58px;
  border:none;
  border-right:1px solid #000;
  background:#fff;
  cursor:pointer;
  font-size:20px;
}

.tisso-variant-btn:last-child{
  border-right:none;
}

.tisso-variant-btn.active{
  background:#111;
  color:#fff;
}

/* SELECT */

.tisso-size-select{
  width:100%;
  height:62px;
  border:1px solid #000;
  padding:0 18px;
  font-size:18px;
  margin-bottom:34px;
  background:#fff;
}

/* BUTTON */

.tisso-add-cart{
  width:100%;
  height:72px;
  background:#000;
  color:#fff;
  border:none;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:24px;
  font-size:24px;
}

/* MOBILE */

@media(max-width:768px){

  .tisso-lookbook-grid{
    grid-template-columns:1fr;
  }

  .tisso-product-popup{
    width:92%;
    padding:22px;
  }

  .tisso-popup-inner{
    grid-template-columns:1fr;
  }

}

</style>

<script>

document.addEventListener('DOMContentLoaded', () => {

  const popup = document.querySelector('.tisso-product-popup');
  const overlay = document.querySelector('.tisso-popup-overlay');
  const closeBtn = document.querySelector('.tisso-popup-close');

  const popupImage = document.querySelector('.tisso-popup-image');
  const popupTitle = document.querySelector('.tisso-popup-title');
  const popupPrice = document.querySelector('.tisso-popup-price');
  const popupDescription = document.querySelector('.tisso-popup-description');

  const variantWrapper = document.querySelector('.tisso-variant-wrapper');
  const sizeWrapper = document.querySelector('.tisso-size-wrapper');

  const addCartBtn = document.querySelector('.tisso-add-cart');

  let currentProduct = null;
  let selectedVariantId = null;

  let selectedColor = null;
  let selectedSize = null;

  /* =========================
     OPEN POPUP
  ========================= */

  document.querySelectorAll('.tisso-plus-btn').forEach(button => {

    button.addEventListener('click', () => {

      const parent = button.closest('.tisso-lookbook-item');

      currentProduct = JSON.parse(
        parent.querySelector('.product-json').textContent
      );

      popup.classList.add('active');
      overlay.classList.add('active');

      renderPopup(currentProduct);

    });

  });

  /* =========================
     RENDER POPUP
  ========================= */

  function renderPopup(product){

    popupImage.src = product.featured_image;

    popupTitle.innerHTML = product.title;

    popupDescription.innerHTML = product.description;

    const firstVariant = product.variants[0];

    selectedVariantId = firstVariant.id;

    popupPrice.innerHTML = formatMoney(firstVariant.price);

    /* =========================
       RESET
    ========================= */

    variantWrapper.innerHTML = '';
    sizeWrapper.innerHTML = '';

    /* =========================
       OPTIONS
    ========================= */

    const options = product.options_with_values || [];

    const colorOption = options.find(
      option => option.name.toLowerCase() === 'color'
    );

    const sizeOption = options.find(
      option => option.name.toLowerCase() === 'size'
    );

    /* =========================
       COLOR BUTTONS
    ========================= */

    if(colorOption){

      selectedColor = colorOption.values[0];

      let colorHTML = `
        <label class="tisso-option-title">
          Color
        </label>

        <div class="tisso-variant-options">
      `;

      colorOption.values.forEach((color, index) => {

        colorHTML += `
          <button
            type="button"
            class="tisso-variant-btn ${index === 0 ? 'active' : ''}"
            data-color="${color}"
          >
            ${color}
          </button>
        `;

      });

      colorHTML += `
        </div>
      `;

      variantWrapper.innerHTML = colorHTML;

      document.querySelectorAll('.tisso-variant-btn')
      .forEach(btn => {

        btn.addEventListener('click', () => {

          document.querySelectorAll('.tisso-variant-btn')
          .forEach(item => item.classList.remove('active'));

          btn.classList.add('active');

          selectedColor = btn.dataset.color;

          updateVariant();

        });

      });

    }

    /* =========================
       SIZE DROPDOWN
    ========================= */

    if(sizeOption){

      selectedSize = sizeOption.values[0];

      let sizeHTML = `
        <label class="tisso-option-title">
          Size
        </label>

        <select class="tisso-size-select">
      `;

      sizeOption.values.forEach(size => {

        sizeHTML += `
          <option value="${size}">
            ${size}
          </option>
        `;

      });

      sizeHTML += `
        </select>
      `;

      sizeWrapper.innerHTML = sizeHTML;

      document.querySelector('.tisso-size-select')
      .addEventListener('change', e => {

        selectedSize = e.target.value;

        updateVariant();

      });

    }

    updateVariant();

  }

  /* =========================
     UPDATE VARIANT
  ========================= */

  function updateVariant(){

    if(!currentProduct) return;

    let matchedVariant = null;

    matchedVariant = currentProduct.variants.find(variant => {

      /* BOTH COLOR + SIZE */

      if(selectedColor && selectedSize){

        return (
          variant.option1 === selectedColor &&
          variant.option2 === selectedSize
        );

      }

      /* ONLY COLOR */

      if(selectedColor){

        return variant.option1 === selectedColor;

      }

      /* ONLY SIZE */

      if(selectedSize){

        return variant.option1 === selectedSize;

      }

      return false;

    });

    if(matchedVariant){

      selectedVariantId = matchedVariant.id;

      popupPrice.innerHTML = formatMoney(
        matchedVariant.price
      );

    }

  }

  /* =========================
     ADD TO CART
  ========================= */

  addCartBtn.addEventListener('click', async () => {

    if(!selectedVariantId) return;

    addCartBtn.disabled = true;

    try {

      const response = await fetch('/cart/add.js', {

        method:'POST',

        headers:{
          'Content-Type':'application/json'
        },

        body:JSON.stringify({
          id:selectedVariantId,
          quantity:1
        })

      });

      if(response.ok){

        addCartBtn.innerHTML = `
          <span>ADDED ✓</span>
        `;

        setTimeout(() => {

          addCartBtn.innerHTML = `
            <span>ADD TO CART</span>
            <span>→</span>
          `;

          addCartBtn.disabled = false;

        },2000);

      }

    } catch(error){

      console.log(error);

      addCartBtn.disabled = false;

    }

  });

  /* =========================
     CLOSE POPUP
  ========================= */

  closeBtn.addEventListener('click', closePopup);

  overlay.addEventListener('click', closePopup);

  function closePopup(){

    popup.classList.remove('active');
    overlay.classList.remove('active');

  }

  /* =========================
     MONEY FORMAT
  ========================= */

  function formatMoney(price){

    return new Intl.NumberFormat('de-DE', {

      style:'currency',
      currency:'EUR'

    }).format(price / 100);

  }

});
</script>

{% schema %}
{
  "name": "Dev Products Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vision in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Lookbook Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Image Optional"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dev Products Grid"
    }
  ]
}
{% endschema %}