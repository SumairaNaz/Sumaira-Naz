<section class="gift-guide-section">
  <div class="gift-guide-wrapper" 
       style="background-color: {{ section.settings.bg_color }};">

    {% if section.settings.bg_image != blank %}
      <div class="gift-guide-bg">
        <img 
          src="{{ section.settings.bg_image | image_url: width: 2200 }}" 
          alt="{{ section.settings.heading }}"
          loading="lazy"
        >
      </div>
    {% endif %}

    <div class="page-width">
      <div class="gift-guide-content">
        
        <h2 style="color: {{ section.settings.text_color }};">
          {{ section.settings.heading }}
        </h2>

        <div class="gift-guide-text" style="color: {{ section.settings.text_color }};">
          {{ section.settings.text | newline_to_br }}
        </div>

        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}" class="gift-guide-btn">
            <span>{{ section.settings.button_label }}</span>

            <svg width="30" height="12" viewBox="0 0 30 12" fill="none">
              <path d="M1 6H28" stroke="white" stroke-width="1.5"/>
              <path d="M23 1L28 6L23 11" stroke="white" stroke-width="1.5"/>
            </svg>
          </a>
        {% endif %}

      </div>
    </div>

    <div class="gift-guide-bottom-strip">
      {{ section.settings.bottom_text }}
    </div>

  </div>
</section>


{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination.\nExplore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom Strip Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#e8e8e8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}


<style>
.gift-guide-section {
  width: 100%;
  overflow: hidden;
}

.gift-guide-wrapper {
  position: relative;
  min-height: 750px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.gift-guide-bg {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.gift-guide-bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

.gift-guide-wrapper .page-width {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  flex: 1;
  display: flex;
  align-items: end;
}

.gift-guide-content {
    max-width: 600px;
    padding: 80px 67px 80px 50px;
}

.gift-guide-content h2 {
    font-size: 70px;
    line-height: 100%;
    margin: 0 0 50px;
    letter-spacing: 0;
}

.gift-guide-text {
    font-size: 20px;
    margin-bottom: 50px;
}

.gift-guide-btn {
    width: 220px;
    height: 50px;
    background: #000;
    color: #fff;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    font-size: 16px;
    line-height: 20.48px;
    /* letter-spacing: 0.5px; */
    transition: all .25s ease;
}

.gift-guide-btn:hover {
  background: #222;
}

.gift-guide-btn svg {
  transition: transform .25s ease;
}

.gift-guide-btn:hover svg {
  transform: translateX(4px);
}

.gift-guide-bottom-strip {
    position: relative;
    z-index: 2;
    width: 100%;
    background: {{ section.settings.bg_color}};
    text-align: center;
    padding: 10px 20px;
    font-size: 16px;
    line-height: 13.42px;
    font-weight: 400;
    letter-spacing: 0;
    color: #000;
    text-transform: uppercase;
}

@media screen and (max-width: 1200px) {
  .gift-guide-content h2 {
    font-size: 60px;
  }

  .gift-guide-text {
    font-size: 17px;
  }
}

@media screen and (max-width: 767px) {
  .gift-guide-wrapper {
    min-height: auto;
  }

  .gift-guide-bg img {
    object-position: center right;
  }

  .gift-guide-content {
    max-width: 100%;
    padding: 70px 0 60px;
  }

  .gift-guide-content h2 {
    font-size: 42px;
    margin-bottom: 20px;
    letter-spacing: -1px;
  }

  .gift-guide-text {
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 32px;
  }

  .gift-guide-btn {
    width: 200px;
    height: 54px;
    font-size: 16px;
  }

  .gift-guide-bottom-strip {
    font-size: 13px;
    padding: 10px 15px;
  }
}
</style>