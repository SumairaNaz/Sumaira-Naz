{% comment %}
  Tisso Vision Announcement Bar
{% endcomment %}

<section class="tisso-announcement-bar">

  <!-- LEFT LOGO IMAGE -->
  <div class="tisso-announcement-left">

    {% if section.settings.logo_image != blank %}
      <img 
        src="{{ section.settings.logo_image | image_url }}" 
        alt="Logo"
        class="tisso-logo"
      >
    {% endif %}

  </div>

  <!-- CENTER TEXT -->
  <div class="tisso-announcement-center">
    {{ section.settings.message_text }}
  </div>

  <!-- RIGHT BUTTON -->
  <a href="{{ section.settings.button_link }}" class="tisso-announcement-button">
    <span>{{ section.settings.button_text }}</span>
    <span class="arrow">→</span>
  </a>

</section>

<style>

.tisso-announcement-bar {
    width: 100%;
    height: 64px;
    background: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
    padding: 10px 50px;
}

/* LEFT LOGO */
.tisso-announcement-left{
  display:flex;
  align-items:center;
}

.tisso-logo{
  max-height:28px;
  width:auto;
  display:block;
}

/* CENTER TEXT */
.tisso-announcement-center {
    font-size: 16px;
    font-weight: 400;
    line-height: 13.42px;
}

/* RIGHT BUTTON */
.tisso-announcement-button {
    width: 207px;
    height: 44px;
    background: #FFF544;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    text-decoration: none;
    transition: 0.3s ease;
    flex-shrink: 0;
    font-size: 16px;
}

.tisso-announcement-button:hover{
  background:#ece11f;
}

.tisso-announcement-button span {
    font-size: 16px;
    font-weight: 400;
    color: #000;
    letter-spacing: 0;
}

.tisso-announcement-button .arrow{
  font-size:20px;
  line-height:1;
}

/* MOBILE */
@media screen and (max-width:768px){

  .tisso-announcement-bar{
    flex-direction:column;
    height:auto;
    padding:20px;
    gap:15px;
  }

  .tisso-announcement-left{
    padding-left:0;
  }

  .tisso-announcement-center{
    position:relative;
    left:auto;
    top:auto;
    transform:none;
    text-align:center;
    white-space:normal;
  }

  .tisso-announcement-button{
    width:100%;
    height:55px;
  }

}

</style>

{% schema %}
{
  "name": "Dev Header",
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background Color"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "message_text",
      "label": "Announcement Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Dev Header"
    }
  ]
}
{% endschema %}