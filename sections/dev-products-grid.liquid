{% comment %}
  Tisso Vision Lookbook Section
{% endcomment %}

<section class="tisso-lookbook">

  <div class="page-width">

    <!-- Heading -->
    <h2 class="tisso-lookbook-heading">
      {{ section.settings.heading }}
    </h2>

    <!-- Grid -->
    <div class="tisso-lookbook-grid">

      {% for block in section.blocks %}
        
        {% assign product = all_products[block.settings.product] %}

        <div class="tisso-lookbook-item">

          <!-- Image -->
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 1000 }}"
              alt=""
              class="tisso-lookbook-image"
            >
            {% else %}
                <img
                src="{{ product.featured_image | image_url: width: 1000 }}"
                alt=""
                class="tisso-lookbook-image"
                >
          {% endif %}

          <!-- Plus Button -->
          <button
            class="tisso-plus-btn"
            data-product-id="{{ product.id }}"
            data-title="{{ product.title }}"
            data-price="{{ product.price | money }}"
            data-image="{{ product.featured_image | image_url: width: 600 }}"
          >
            +
          </button>

          <!-- Hidden Product JSON -->
          <script type="application/json" class="product-json">
            {
            "id": {{ product.id }},
            "title": {{ product.title | json }},
            "description": {{ product.description | strip_html | json }},
            "featured_image": {{ product.featured_image | image_url: width: 900 | json }},
            "options_with_values": {{ product.options_with_values | json }},
            "variants": [
                {% for variant in product.variants %}
                {
                    "id": {{ variant.id }},
                    "title": {{ variant.title | json }},
                    "price": {{ variant.price }},
                    "option1": {{ variant.option1 | json }},
                    "option2": {{ variant.option2 | json }},
                    "option3": {{ variant.option3 | json }}
                }{% unless forloop.last %},{% endunless %}
                {% endfor %}
            ]
            }
        </script>

        </div>

      {% endfor %}

    </div>

  </div>
</section>

<!-- POPUP -->
<div class="tisso-popup-overlay"></div>

<div class="tisso-product-popup">

  <button class="tisso-popup-close">
    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 17 17" fill="none">
    <path d="M4.24219 4.24285L12.7275 12.7281" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
    <path d="M4.24219 12.7277L12.7275 4.24243" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
    </svg>
  </button>

  <div class="tisso-popup-inner">

    <!-- LEFT -->
    <div class="tisso-popup-image-wrap">
      <img src="" alt="" class="tisso-popup-image">
    </div>

    <!-- RIGHT -->
    <div class="tisso-popup-content">

      <h3 class="tisso-popup-title"></h3>

      <div class="tisso-popup-price"></div>

      <div class="tisso-popup-description"></div>

    </div>

  </div>
   <div class="tisso-popup-contentdev_full-width">
        <!-- Variant Options -->
      <div class="tisso-variant-wrapper"></div>

      <!-- Size -->
      <div class="tisso-size-wrapper"></div>

      <!-- Add to Cart -->
      <button class="tisso-add-cart">
        <span>ADD TO CART</span>
        <span>→</span>
      </button>
    </div>

</div>



<style>

/* =========================
   SECTION
========================= */

.tisso-lookbook{
  background:#efefef;
  padding:30px 0;
}

.tisso-lookbook .page-width{
  max-width:1280px;
  margin:0 auto;
  padding:0 28px;
}

.tisso-lookbook-heading{
  font-size:52px;
  font-weight:400;
  margin-bottom:30px;
  font-family:Georgia, serif;
  color:#111;
}

/* =========================
   GRID
========================= */

.tisso-lookbook-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:22px;
}

.tisso-lookbook-item{
  position:relative;
  overflow:hidden;
  height:520px;
}

.tisso-lookbook-image{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}

/* PLUS BUTTON */

.tisso-plus-btn{
  position:absolute;
  top:50%;
  right:22px;
  transform:translateY(-50%);
  width:38px;
  height:38px;
  border-radius:50%;
  border:none;
  background:#fff;
  color:#000;
  font-size:28px;
  cursor:pointer;
  z-index:2;
}

/* =========================
   POPUP
========================= */

.tisso-popup-overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,0.45);
  opacity:0;
  visibility:hidden;
  transition:0.3s;
  z-index:9998;
}

.tisso-popup-overlay.active{
  opacity:1;
  visibility:visible;
}

.tisso-product-popup{
  position:fixed;
  top:50%;
  left:50%;
  transform:translate(-50%,-50%) scale(.9);
  width:310px;
  background:#f4f1ec;
  padding:36px 20px;
  z-index:9999;
  opacity:0;
  visibility:hidden;
  transition:0.3s;
}

.tisso-product-popup.active{
  opacity:1;
  visibility:visible;
  transform:translate(-50%,-50%) scale(1);
}

/* CLOSE */

.tisso-popup-close{
  position:absolute;
  top:12px;
  right:6px;
  background:none;
  border:none;
  font-size:12px;
  cursor:pointer;
}

/* INNER */

.tisso-popup-inner{
  display:grid;
  grid-template-columns:120px 1fr; /* smaller image like design */
  gap:8px;
  align-items:start;
  padding-top: 6px;
}

/* IMAGE */

.tisso-popup-image{
  width:100%;
  display:block;
}

/* TITLE */

.tisso-popup-title{
  font-size:16px;
  margin-bottom:20px;
  font-weight:400;
}

/* PRICE */

.tisso-popup-price {
    font-size: 16px;
    margin-bottom: 12px;
}

/* DESCRIPTION */

.tisso-popup-description{
  font-size:16px;
  line-height:1.5;
  margin-bottom:24px;
  color:#444;
}

/* VARIANTS */

.tisso-option-title{
  font-size:14px;
  margin-bottom:10px;
  display:block;
}

.tisso-variant-options{
  display:flex;
  margin-bottom:10px;
}

.tisso-variant-btn{
  flex:1;
  height:40px;
  border:none;
  border: 0.5px solid #000 !important;
  background:#fff;
  cursor:pointer;
  font-size:18px;
  position: relative;
}

.tisso-variant-btn:last-child{
  border-right:none;
}

.tisso-variant-btn.active{
  background:#111;
  color:#fff;
}

/* SELECT */

.tisso-size-select{
  width:100%;
  height:62px;
  border:1px solid #000;
  padding:0 18px;
  font-size:18px;
  margin-bottom:34px;
  background:#fff;
}

/* BUTTON */

.tisso-add-cart{
  width:100%;
  height:45px;
  background:#000;
  color:#fff;
  border:none;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:24px;
  font-size:16px;
}
.tisso-add-cart span:last-child {
    font-size: 25px;
}
.tisso-custom-select{
  border:1px solid #000;
  background:#fff;
  position:relative;
  font-family:inherit;
}

/* TOP BAR */
.tisso-select-head {
    height: 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 0 0 13px;
    cursor: pointer;
}

.tisso-select-label {
    font-size: 16px;
    color: #000;
    letter-spacing: -2%;
}

.tisso-selected-value{
  display:none;
}

/* DROPDOWN */
.tisso-select-dropdown{
  display:none;
  border-top:1px solid #000;
  background:#fff;
}

.tisso-select-dropdown.active{
  display:block;
}

.tisso-select-item {
    padding: 5px 16px;
    cursor: pointer;
    font-size: 16px;
}
.tisso-select-item:hover{
  background:#000;
  color:#fff;
}
.tisso-variant-wrapper,
.tisso-size-wrapper{
  width:100%;
}
.tisso-variant-btn span {
    height: 100%;
    width: 5px;
    position: absolute;
    left: 0;
    top: 0;
    border-right: 0.5px solid #000;
}
.tisso-right {
    border-left: 1px solid;
    height: 100%;
    width: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

/* MOBILE */

@media(max-width:768px){

  .tisso-lookbook-grid{
    grid-template-columns:1fr;
  }

  .tisso-product-popup{
    width:92%;
    padding:22px;
  }

  .tisso-popup-inner{
    grid-template-columns:1fr;
  }

}

</style>

<script>

document.addEventListener('DOMContentLoaded', () => {

  const popup = document.querySelector('.tisso-product-popup');
  const overlay = document.querySelector('.tisso-popup-overlay');
  const closeBtn = document.querySelector('.tisso-popup-close');

  const popupImage = document.querySelector('.tisso-popup-image');
  const popupTitle = document.querySelector('.tisso-popup-title');
  const popupPrice = document.querySelector('.tisso-popup-price');
  const popupDescription = document.querySelector('.tisso-popup-description');

  const variantWrapper = document.querySelector('.tisso-variant-wrapper');
  const sizeWrapper = document.querySelector('.tisso-size-wrapper');

  const addCartBtn = document.querySelector('.tisso-add-cart');

  let currentProduct = null;
  let selectedVariantId = null;

  let selectedColor = null;
  let selectedSize = null;

  /* =========================
     OPEN POPUP
  ========================= */

  document.querySelectorAll('.tisso-plus-btn').forEach(button => {

    button.addEventListener('click', () => {

      const parent = button.closest('.tisso-lookbook-item');

      currentProduct = JSON.parse(
        parent.querySelector('.product-json').textContent
      );

      popup.classList.add('active');
      overlay.classList.add('active');

      renderPopup(currentProduct);

    });

  });

  /* =========================
     RENDER POPUP
  ========================= */

  function renderPopup(product) {

    popupImage.src = product.featured_image;
    popupTitle.textContent = product.title;
    popupDescription.textContent = product.description;

    const variants = product.variants || [];

    const firstVariant = variants[0];

    selectedVariantId = firstVariant.id;

    popupPrice.innerHTML = formatMoney(firstVariant.price);

    variantWrapper.innerHTML = '';
    sizeWrapper.innerHTML = '';

    const options = product.options_with_values || [];

    /* =========================
       COLOR
    ========================= */

    const colorOption = options.find(
      o => (o.name || '').toLowerCase().includes('color')
    );

    if (colorOption) {

      const uniqueColors = [...new Set(colorOption.values || [])];

      selectedColor = uniqueColors[0];

      let colorHTML = `
         <div class="tisso-option-title">Color</div>
         <div class="tisso-variant-options">
      `;

      uniqueColors.forEach((color, index) => {

        colorHTML += `
          <button
            type="button"
            class="tisso-variant-btn ${index === 0 ? 'active' : ''}"
            data-color="${color}"
          ><span style="background-color:${color}"></span>
            ${color}
          </button>
        `;

      });

      colorHTML += `</div>`;

      variantWrapper.innerHTML = colorHTML;

      document.querySelectorAll('.tisso-variant-btn').forEach(btn => {

        btn.addEventListener('click', () => {

          document.querySelectorAll('.tisso-variant-btn')
            .forEach(b => b.classList.remove('active'));

          btn.classList.add('active');

          selectedColor = btn.dataset.color;

          updateVariant();

        });

      });

    }

    /* =========================
       SIZE
    ========================= */

    const sizeOption = options.find(
      o => (o.name || '').toLowerCase().includes('size')
    );

    if (sizeOption) {

      selectedSize = sizeOption.values[0];

      let sizeHTML = `
        <div class="tisso-option-title">Size</div>
        <div class="tisso-custom-select">

          <div class="tisso-select-head">
            <span class="tisso-select-label">Choose your size</span>

            <div class="tisso-right">
              <span class="tisso-selected-value">${selectedSize}</span>
              <span class="tisso-arrow"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="9" viewBox="0 0 15 9" fill="none">
<path d="M1.06067 1.06067L7.06067 7.06067L13.0607 1.06067" stroke="black" stroke-width="1.5" stroke-linecap="square"/>
</svg></span>
            </div>
          </div>

          <div class="tisso-select-dropdown">
      `;

      sizeOption.values.forEach(size => {

        sizeHTML += `
          <div class="tisso-select-item" data-value="${size}">
            ${size}
          </div>
        `;

      });

      sizeHTML += `
          </div>
        </div>
      `;

      sizeWrapper.innerHTML = sizeHTML;

      const dropdown = document.querySelector('.tisso-select-dropdown');
      const head = document.querySelector('.tisso-select-head');
      const valueEl = document.querySelector('.tisso-selected-value');

      head.addEventListener('click', () => {
        dropdown.classList.toggle('active');
      });

      document.querySelectorAll('.tisso-select-item').forEach(item => {

        item.addEventListener('click', () => {

          selectedSize = item.dataset.value;
          valueEl.textContent = selectedSize;

          dropdown.classList.remove('active');

          updateVariant();

        });

      });

    }

    updateVariant();

  }

  /* =========================
     UPDATE VARIANT (FIXED)
  ========================= */

  function updateVariant() {

    if (!currentProduct) return;

    const variants = currentProduct.variants || [];

    const normalize = (v) =>
      (v || '').toString().toLowerCase().trim();

    const color = normalize(selectedColor);
    const size = normalize(selectedSize);

    let matchedVariant = null;

    for (let i = 0; i < variants.length; i++) {

      const v = variants[i];

      const options = [
        normalize(v.option1),
        normalize(v.option2),
        normalize(v.option3)
      ];

      if (color && size) {
        if (options.includes(color) && options.includes(size)) {
          matchedVariant = v;
          break;
        }
      }

      else if (color) {
        if (options.includes(color)) {
          matchedVariant = v;
          break;
        }
      }

      else if (size) {
        if (options.includes(size)) {
          matchedVariant = v;
          break;
        }
      }
    }

    if (!matchedVariant) {
      matchedVariant = variants[0];
    }

    selectedVariantId = matchedVariant.id;

    popupPrice.innerHTML = formatMoney(matchedVariant.price);

    if (matchedVariant.featured_image) {
      popupImage.src = matchedVariant.featured_image.src;
    }
  }

  /* =========================
     ADD TO CART
  ========================= */

  addCartBtn.addEventListener('click', async () => {

    if (!selectedVariantId) return;

    addCartBtn.disabled = true;

    try {

      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          id: selectedVariantId,
          quantity: 1
        })
      });

      if (res.ok) {

        addCartBtn.innerHTML = `<span>ADDED ✓</span>`;

        setTimeout(() => {

          addCartBtn.innerHTML = `
            <span>ADD TO CART</span>
            <span>→</span>
          `;

          addCartBtn.disabled = false;

        }, 2000);

      }

    } catch (err) {
      console.log(err);
      addCartBtn.disabled = false;
    }

  });

  /* =========================
     CLOSE
  ========================= */

  closeBtn.addEventListener('click', closePopup);
  overlay.addEventListener('click', closePopup);

  function closePopup() {
    popup.classList.remove('active');
    overlay.classList.remove('active');
  }

  /* =========================
     MONEY
  ========================= */

  function formatMoney(price) {
    return new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD'
    }).format(price / 100);
  }

});
</script>

{% schema %}
{
  "name": "Dev Products Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vision in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Lookbook Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Image Optional"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dev Products Grid"
    }
  ]
}
{% endschema %}