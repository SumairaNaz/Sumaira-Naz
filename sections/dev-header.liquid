{% comment %}
  Tisso Vision Announcement Bar
{% endcomment %}

<section class="tisso-announcement-bar">

  <!-- LEFT LOGO IMAGE -->
  <div class="tisso-announcement-left">

    {% if section.settings.logo_image != blank %}
      <img 
        src="{{ section.settings.logo_image | image_url }}" 
        alt="Logo"
        class="tisso-logo"
      >
    {% endif %}

  </div>

  <!-- CENTER TEXT -->
  <div class="tisso-announcement-center">
    {{ section.settings.message_text }}
  </div>

  <!-- RIGHT BUTTON -->
  <a href="{{ section.settings.button_link }}" class="tisso-announcement-button">
    <span>{{ section.settings.button_text }}</span>
    <span class="arrow"><svg xmlns="http://www.w3.org/2000/svg" width="26" height="12" viewBox="0 0 26 12" fill="none">
<path d="M0.75 4.77298L7.37629e-08 4.77298L-7.37629e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.21968C20.2145 -0.073213 19.7396 -0.0732131 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="black"/>
</svg></span>
  </a>

</section>

<style>

.tisso-announcement-bar {
    width: 100%;
    height: 64px;
    background: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
    padding: 10px 50px;
}

/* LEFT LOGO */
.tisso-announcement-left{
  display:flex;
  align-items:center;
}

.tisso-logo{
  max-height:28px;
  width:auto;
  display:block;
}

/* CENTER TEXT */
.tisso-announcement-center {
    font-size: 16px;
    font-weight: 400;
    line-height: 13.42px;
}

/* RIGHT BUTTON */
.tisso-announcement-button {
    width: 207px;
    height: 44px;
    background: #FFF544;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    text-decoration: none;
    transition: color 0.3s ease-in-out;
    flex-shrink: 0;
    font-size: 16px;
}

.tisso-announcement-button:hover{
  background: #000;
  color: #fff;
  border-color: #000;

.tisso-announcement-button span {
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0;
}
.tisso-announcement-button::before{
   content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 0%;
  height: 100%;
  background: #000;
  transition: width 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  z-index: -1;
}
.tisso-announcement-button:hover::before {
  width:100%;
}

.tisso-announcement-button .arrow{
  font-size:20px;
  line-height:1;
}

/* MOBILE */
@media screen and (max-width:768px){

  .tisso-announcement-bar{
    flex-direction:column;
    height:auto;
    padding:20px;
    gap:15px;
  }

  .tisso-announcement-left{
    padding-left:0;
  }

  .tisso-announcement-center{
    position:relative;
    left:auto;
    top:auto;
    transform:none;
    text-align:center;
    white-space:normal;
  }

  .tisso-announcement-button{
    width:100%;
    height:55px;
  }

}

</style>

{% schema %}
{
  "name": "Dev Header",
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background Color"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "message_text",
      "label": "Announcement Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Dev Header"
    }
  ]
}
{% endschema %}