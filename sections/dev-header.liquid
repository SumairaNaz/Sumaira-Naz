{% comment %}
  Tisso Vision Announcement Bar
{% endcomment %}

<section class="tisso-announcement-bar">

  <!-- LEFT LOGO IMAGE -->
  <div class="tisso-announcement-left">

    {% if section.settings.logo_image != blank %}
      <img 
        src="{{ section.settings.logo_image | image_url }}" 
        alt="Logo"
        class="tisso-logo"
      >
    {% endif %}

  </div>

  <!-- CENTER TEXT -->
  <div class="tisso-announcement-center">
    {{ section.settings.message_text }}
  </div>

  <!-- RIGHT BUTTON -->
  <a href="{{ section.settings.button_link }}" class="tisso-announcement-button">
    <span>{{ section.settings.button_text }}</span>
    <span class="arrow">→</span>
  </a>

</section>

<style>

.tisso-announcement-bar{
  width:100%;
  height:72px;
  background:{{ section.settings.bg}};
  display:flex;
  align-items:center;
  justify-content:space-between;
  position:relative;
  overflow:hidden;
}

/* LEFT LOGO */
.tisso-announcement-left{
  padding-left:50px;
  display:flex;
  align-items:center;
}

.tisso-logo{
  max-height:28px;
  width:auto;
  display:block;
}

/* CENTER TEXT */
.tisso-announcement-center{
  position:absolute;
  left:50%;
  top:50%;
  transform:translate(-50%, -50%);
  font-size:14px;
  font-weight:400;
  color:#111;
  white-space:nowrap;
  font-family:Arial, sans-serif;
}

/* RIGHT BUTTON */
.tisso-announcement-button{
  width:185px;
  height:72px;
  background:#f4eb27;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:12px;
  text-decoration:none;
  transition:0.3s ease;
  flex-shrink:0;
}

.tisso-announcement-button:hover{
  background:#ece11f;
}

.tisso-announcement-button span{
  font-size:14px;
  font-weight:700;
  color:#000;
  letter-spacing:0.5px;
  font-family:Arial, sans-serif;
}

.tisso-announcement-button .arrow{
  font-size:20px;
  line-height:1;
}

/* MOBILE */
@media screen and (max-width:768px){

  .tisso-announcement-bar{
    flex-direction:column;
    height:auto;
    padding:20px;
    gap:15px;
  }

  .tisso-announcement-left{
    padding-left:0;
  }

  .tisso-announcement-center{
    position:relative;
    left:auto;
    top:auto;
    transform:none;
    text-align:center;
    white-space:normal;
  }

  .tisso-announcement-button{
    width:100%;
    height:55px;
  }

}

</style>

{% schema %}
{
  "name": "Dev Header",
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background Color"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "message_text",
      "label": "Announcement Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Dev Header"
    }
  ]
}
{% endschema %}