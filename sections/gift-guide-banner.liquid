<section class="gift-guide-section">
  <div class="gift-guide-wrapper" 
       style="background-color: {{ section.settings.bg_color }};">

    {% if section.settings.bg_image != blank %}
      <div class="gift-guide-bg">
        <img 
          src="{{ section.settings.bg_image | image_url: width: 2200 }}" 
          alt="{{ section.settings.heading }}"
          loading="lazy"
        >
      </div>
    {% endif %}

    <div class="page-width">
      <div class="gift-guide-content">
        
        <h2 style="color: {{ section.settings.text_color }};">
          {{ section.settings.heading }}
        </h2>

        <div class="gift-guide-text" style="color: {{ section.settings.text_color }};">
          {{ section.settings.text | newline_to_br }}
        </div>

        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}" class="gift-guide-btn">
            <span>{{ section.settings.button_label }}</span>

            <svg xmlns="http://www.w3.org/2000/svg" width="27" height="12" viewBox="0 0 27 12" fill="none">
<path d="M0.75 4.77295L7.83954e-08 4.77295L-7.83954e-08 6.27295L0.75 6.27295L0.75 4.77295ZM26.7876 6.05328C27.0805 5.76039 27.0805 5.28551 26.7876 4.99262L22.0146 0.21965C21.7217 -0.0732435 21.2468 -0.0732435 20.9539 0.21965C20.6611 0.512543 20.6611 0.987417 20.9539 1.28031L25.1966 5.52295L20.9539 9.76559C20.6611 10.0585 20.6611 10.5334 20.9539 10.8263C21.2468 11.1191 21.7217 11.1191 22.0146 10.8263L26.7876 6.05328ZM0.75 6.27295L26.2572 6.27295L26.2572 4.77295L0.75 4.77295L0.75 6.27295Z" fill="white"/>
</svg>
          </a>
        {% endif %}

      </div>
    </div>

    <div class="gift-guide-bottom-strip">
      {{ section.settings.bottom_text }}
    </div>

  </div>
</section>


{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination.\nExplore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom Strip Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#e8e8e8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}


<style>
.gift-guide-section {
  width: 100%;
  overflow: hidden;
}

.gift-guide-wrapper {
  position: relative;
  min-height: 750px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.gift-guide-bg {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.gift-guide-bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

.gift-guide-wrapper .page-width {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  flex: 1;
  display: flex;
  align-items: end;
}

.gift-guide-content {
    max-width: 600px;
    padding: 80px 67px 80px 50px;
}

.gift-guide-content h2 {
    font-size: 70px;
    line-height: 100%;
    margin: 0 0 50px;
    letter-spacing: 0;
}

.gift-guide-text {
    font-size: 20px;
    margin-bottom: 50px;
}

.gift-guide-btn {
    width: 220px;
    height: 50px;
    color: #fff;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    font-size: 16px;
    line-height: 20.48px;
    /* letter-spacing: 0.5px; */
    transition: background-size .45s cubic-bezier(.785,.135,.15,.86),background-position .45s step-end,color .45s cubic-bezier(.785,.135,.15,.86),border .45s cubic-bezier(.785,.135,.15,.86);
     --initial-gradient: linear-gradient(#000, #000);
    --hover-gradient: linear-gradient(#FFF544, #FFF544);
    --initial-background-position: left;
    --hover-background-position: right;
    background-image: var(--initial-gradient),var(--hover-gradient);
    background-size: 101% 101%,0 101%;
    background-position: right;
    background-repeat: no-repeat;
}

.gift-guide-btn:hover {
    color: #000;
    background-size: 0 101%,101% 101%;
    background-position: var(--hover-background-position);
}

.gift-guide-btn:hover svg path{
    fill:#000;
}

.gift-guide-bottom-strip {
    position: relative;
    z-index: 2;
    width: 100%;
    background: {{ section.settings.bg_color}};
    text-align: center;
    padding: 10px 20px;
    font-size: 16px;
    line-height: 13.42px;
    font-weight: 400;
    letter-spacing: 0;
    color: #000;
    text-transform: uppercase;
}

@media screen and (max-width: 1200px) {
  .gift-guide-content h2 {
    font-size: 60px;
  }

  .gift-guide-text {
    font-size: 17px;
  }
}

@media screen and (max-width: 767px) {
  .gift-guide-wrapper {
    min-height: auto;
  }

  .gift-guide-bg img {
    object-position: left;
  }

  .gift-guide-content {
    max-width: 100%;
    padding: 70px 0 60px;
    text-align: center;
  }

  .gift-guide-content h2 {
    font-size: 30px;
    margin-bottom: 20px;
  }

  .gift-guide-text {
    font-size: 16px;
  }

  .gift-guide-btn {
    width: 193px;
    height: 45px;
    font-size: 16px;
  }

  .gift-guide-bottom-strip {
    font-size: 13px;
    padding: 10px 15px;
  }
}
</style>